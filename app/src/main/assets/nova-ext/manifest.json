{
  "manifest_version": 2,
  "name": "Nova media detector",
  "version": "2.0",
  "browser_specific_settings": { "gecko": { "id": "nova-detector@nova.app" } },
  "permissions": ["webRequest", "<all_urls>", "tabs", "nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start" }
  ]
}
